@baseUrl = http://localhost:5000
# Paste tokens from the login responses (don't commit real tokens)
@tokenA = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI2YWNhODRiZjRlYjhhNThlMjRlMTY0YmMiLCJpYXQiOjE3OTE2OTQwODcsImV4cCI6MTc5MjI5ODg4N30.1uO4Bdiya1BK1NScHdeWsOyLbVyrnnb2klYYQcrwFso
@tokenB = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI2YWNiMTI3MGI5MmMwMmEyMTM3MjUwZjIiLCJpYXQiOjE3OTE2OTQxMTEsImV4cCI6MTc5MjI5ODkxMX0.jnVfUfCzKIS_2PSaJ-hYMnjSc1p5wga6JWiEv5DYX0I

# Paste a debate id from the create response
@debateId = 6aca91219a438779f1ffe079

### Health check
GET {{baseUrl}}/api/health

### Register user A
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "debate_user",
  "email": "debate.user@example.com",
  "password": "strong-password-123"
}

### Register user B
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "debate_user2",
  "email": "debate.user2@example.com",
  "password": "strong-password-123"
}

### Login user A
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "debate.user@example.com",
  "password": "strong-password-123"
}

### Login user B
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "debate.user2@example.com",
  "password": "strong-password-123"
}

### Current user (A)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{tokenA}}

### Create a debate (ends in 7 days)
POST {{baseUrl}}/api/debates
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "title": "Should cities ban private cars downtown?",
  "description": "Consider the effects on traffic, air quality, local businesses, and accessibility.",
  "category": "environment",
  "endsAt": "{{$datetime iso8601 7 d}}"
}

### List debates
GET {{baseUrl}}/api/debates?limit=9

### List: search + category + sort
GET {{baseUrl}}/api/debates?search=cars&category=environment&sort=ending-soon

### List: limit cap test (expect 400 or limit 50)
GET {{baseUrl}}/api/debates?limit=9999

### Get debate by id
GET {{baseUrl}}/api/debates/{{debateId}}

### Get debate with garbage id (expect 404)
GET {{baseUrl}}/api/debates/abc

### Vote For (expect voteCounts.for to increase)
PUT {{baseUrl}}/api/debates/{{debateId}}/vote
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "choice": "for"
}

### Change vote to Against (expect For -1 and Against +1)
PUT {{baseUrl}}/api/debates/{{debateId}}/vote
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "choice": "against"
}

### Change vote to Neutral
PUT {{baseUrl}}/api/debates/{{debateId}}/vote
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "choice": "neutral"
}

### Same vote twice (both requests are idempotent)
PUT {{baseUrl}}/api/debates/{{debateId}}/vote
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "choice": "neutral"
}

### 
PUT {{baseUrl}}/api/debates/{{debateId}}/vote
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "choice": "neutral"
}

### Vote without token (expect 401)
PUT {{baseUrl}}/api/debates/{{debateId}}/vote
Content-Type: application/json

{
  "choice": "for"
}

### Invalid vote choice (expect 400)
PUT {{baseUrl}}/api/debates/{{debateId}}/vote
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "choice": "maybe"
}

### Vote on debate with garbage id (expect 404)
PUT {{baseUrl}}/api/debates/abc/vote
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "choice": "for"
}

### Get my vote (expect "neutral")
GET {{baseUrl}}/api/debates/{{debateId}}/vote/me
Authorization: Bearer {{tokenA}}

### Get debate as A (expect myVote and updated voteCounts)
GET {{baseUrl}}/api/debates/{{debateId}}
Authorization: Bearer {{tokenA}}

### Remove vote (expect myVote: null and Neutral -1)
DELETE {{baseUrl}}/api/debates/{{debateId}}/vote
Authorization: Bearer {{tokenA}}

### A posts a For argument (expect 201)
POST {{baseUrl}}/api/debates/{{debateId}}/arguments
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "side": "for",
  "text": "This is a supporting argument with at least twenty characters."
}

### A posts Against (expect 409)
POST {{baseUrl}}/api/debates/{{debateId}}/arguments
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "side": "against",
  "text": "This is an opposing argument with at least twenty characters."
}

### B posts Against (expect 201)
POST {{baseUrl}}/api/debates/{{debateId}}/arguments
Content-Type: application/json
Authorization: Bearer {{tokenB}}

{
  "side": "against",
  "text": "Another opposing argument with plenty of characters in it."
}

### No token (expect 401)
POST {{baseUrl}}/api/debates/{{debateId}}/arguments
Content-Type: application/json

{
  "side": "for",
  "text": "This should be rejected because there is no token."
}

### Invalid side (expect 400)
POST {{baseUrl}}/api/debates/{{debateId}}/arguments
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "side": "maybe",
  "text": "This has a long enough text but an invalid side."
}

### Text too short (expect 400)
POST {{baseUrl}}/api/debates/{{debateId}}/arguments
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "side": "for",
  "text": "Too short"
}

### Post on garbage debate id (expect 404)
POST {{baseUrl}}/api/debates/abc/arguments
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "side": "for",
  "text": "Valid text but the debate id does not exist."
}

### List arguments as guest (expect no mySide)
GET {{baseUrl}}/api/debates/{{debateId}}/arguments

### List arguments as A (expect mySide: "for")
GET {{baseUrl}}/api/debates/{{debateId}}/arguments
Authorization: Bearer {{tokenA}}

### List For arguments, top sort
GET {{baseUrl}}/api/debates/{{debateId}}/arguments?page=1&limit=10&side=for&sort=top

### Limit cap test (expect 400 or limit 50)
GET {{baseUrl}}/api/debates/{{debateId}}/arguments?limit=9999